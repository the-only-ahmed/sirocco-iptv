{
  "rootDir": "src",
  "files": [
    "manifest",
    "source/**/*",
    "components/**/*",
    "images/**/*",
    "locale/**/*"
  ],
  "stagingDir": "build/staging",
  "outFile": "build/sirocco-iptv.zip",
  "retainStagingDir": true,
  "autoImportComponentScript": false,
  "sourceMap": true,
  "plugins": ["@rokucommunity/bslint"],
  "diagnosticFilters": [
    { "src": "**/node_modules/**/*", "codes": [] }
  ]
}
