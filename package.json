{
  "name": "sirocco-iptv-roku",
  "version": "1.0.0",
  "private": true,
  "description": "Xtream Codes IPTV player for Roku (BrighterScript + SceneGraph)",
  "scripts": {
    "build": "bsc",
    "watch": "bsc --watch",
    "deploy": "bsc --deploy --host \"$ROKU_HOST\" --password \"$ROKU_PASSWORD\"",
    "clean": "rm -rf build",
    "build:release": "bash scripts/build-release.sh",
    "deploy:release": "bash scripts/build-release.sh --deploy"
  },
  "devDependencies": {
    "@rokucommunity/bslint": "^0.8.33",
    "brighterscript": "^0.69.13"
  }
}
