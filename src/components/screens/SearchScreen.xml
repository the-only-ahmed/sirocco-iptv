<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard on the left, results on the right. Searches the cached catalogues, no requests per keystroke. -->
<component name="SearchScreen" extends="BaseScreen">
  <children>
    <Label id="title" translation="[120, 60]" font="font:LargeBoldSystemFont" color="#FFFFFF" />

    <MiniKeyboard id="keyboard" translation="[120, 150]" />
    <Label id="typed" translation="[120, 620]" width="500" height="40"
           font="font:MediumBoldSystemFont" color="#FFFFFF" />
    <Label id="hint" translation="[120, 668]" width="500" height="60" wrap="true" maxLines="2"
           font="font:SmallestSystemFont" color="#5C6577" />

    <Label id="count" translation="[700, 150]" width="1100" height="30"
           font="font:SmallestSystemFont" color="#8A93A6" />
    <MarkupGrid id="results" translation="[700, 200]"
                itemComponentName="PosterItem"
                itemSize="[240, 370]" itemSpacing="[16, 24]"
                numColumns="4" numRows="2" drawFocusFeedback="true" />

    <!-- 250 ms after the last keypress: searching on every letter makes the keyboard lag -->
    <Timer id="debounce" repeat="false" duration="0.25" />
  </children>
  <script type="text/brighterscript" uri="SearchScreen.bs" />
</component>
