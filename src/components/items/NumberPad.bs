' 3 x 4 grid: digits, then Clear / 0 / OK.
const COLUMNS = 3
const KEY_WIDTH = 120
const KEY_HEIGHT = 90
const MAX_DIGITS = 6

sub init()
    m.body = m.top.findNode("body")
    m.title = m.top.findNode("title")
    m.display = m.top.findNode("display")
    m.keys = m.top.findNode("keys")

    m.labels = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "Clear", "0", "OK"]
    m.keyNodes = []
    m.value = ""
    m.masked = false
    m.focusIndex = 0
    buildKeys()
end sub

sub buildKeys()
    for i = 0 to m.labels.Count() - 1
        column = i mod COLUMNS
        row = Int(i / COLUMNS)

        key = m.keys.createChild("Group")
        key.translation = [column * (KEY_WIDTH + 10), row * (KEY_HEIGHT + 10)]

        background = key.createChild("Rectangle")
        background.width = KEY_WIDTH
        background.height = KEY_HEIGHT
        background.color = "#0B0F19"

        label = key.createChild("Label")
        label.width = KEY_WIDTH
        label.height = KEY_HEIGHT
        label.horizAlign = "center"
        label.vertAlign = "center"
        label.font = "font:MediumBoldSystemFont"
        label.color = "#D5DAE5"
        label.text = m.labels[i]

        m.keyNodes.Push({ background: background, label: label })
    end for
end sub

sub onPrompt()
    prompt = m.top.prompt
    if prompt = invalid then return

    m.title.text = asText(prompt.title)
    m.masked = (prompt.masked = true)
    m.value = ""
    m.focusIndex = 0
    render()

    m.body.visible = true
    m.top.setFocus(true)
end sub

sub render()
    if m.masked
        m.display.text = String(Len(m.value), "•")
    else
        m.display.text = m.value
    end if

    for i = 0 to m.keyNodes.Count() - 1
        if i = m.focusIndex
            m.keyNodes[i].background.color = "#6366F1"
            m.keyNodes[i].label.color = "#FFFFFF"
        else
            m.keyNodes[i].background.color = "#0B0F19"
            m.keyNodes[i].label.color = "#D5DAE5"
        end if
    end for
end sub

sub finish(value as string)
    m.body.visible = false
    m.top.entered = value
end sub

sub activate(index as integer)
    label = m.labels[index]
    if label = "OK"
        finish(m.value)
    else if label = "Clear"
        if Len(m.value) > 0 then m.value = Left(m.value, Len(m.value) - 1)
        render()
    else
        addDigit(label)
    end if
end sub

sub addDigit(digit as string)
    if Len(m.value) >= MAX_DIGITS then return
    m.value += digit
    render()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or not m.body.visible then return false

    ' Remotes with a number pad (and ECP Lit_N) can type straight in.
    digit = digitFromKey(key)
    if digit <> ""
        addDigit(digit)
        return true
    end if

    if key = "back"
        finish("")
        return true
    else if key = "OK"
        activate(m.focusIndex)
        return true
    else if key = "left"
        if m.focusIndex mod COLUMNS > 0 then m.focusIndex -= 1
    else if key = "right"
        if m.focusIndex mod COLUMNS < COLUMNS - 1 and m.focusIndex < m.labels.Count() - 1 then m.focusIndex += 1
    else if key = "up"
        if m.focusIndex >= COLUMNS then m.focusIndex -= COLUMNS
    else if key = "down"
        if m.focusIndex + COLUMNS < m.labels.Count() then m.focusIndex += COLUMNS
    else
        return false
    end if

    render()
    return true
end function

function digitFromKey(key as string) as string
    k = LCase(key)
    if Len(k) = 1 and k >= "0" and k <= "9" then return k
    if Left(k, 4) = "lit_"
        c = Right(k, 1)
        if c >= "0" and c <= "9" then return c
    end if
    return ""
end function

function asText(value as dynamic) as string
    if value = invalid or GetInterface(value, "ifString") = invalid then return ""
    return value
end function
