<?xml version="1.0" encoding="utf-8"?>
<!--
  RowList cell. Shows the poster when the item has one, and a titled tile when it does not
  (live categories carry no artwork). Grows slightly as focus moves onto it.
-->
<component name="RowItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
  </interface>
  <children>
    <Group id="scaler" scaleRotateCenter="[110, 150]">
      <Rectangle id="tile" width="220" height="300" color="#151B2B" />
      <Poster id="poster" width="220" height="300" visible="false"
              loadDisplayMode="scaleToZoom" loadWidth="220" loadHeight="300"
              failedBitmapUri="pkg:/images/placeholder.png" />
      <Label id="tileText" width="184" height="300" translation="[18, 0]" visible="false"
             horizAlign="center" vertAlign="center" wrap="true" maxLines="4"
             font="font:MediumBoldSystemFont" color="#FFFFFF" />
    </Group>
    <Label id="caption" width="220" height="52" translation="[0, 308]"
           horizAlign="center" wrap="true" maxLines="2"
           font="font:SmallestSystemFont" color="#D5DAE5" />
  </children>
  <script type="text/brighterscript" uri="RowItem.bs" />
</component>
