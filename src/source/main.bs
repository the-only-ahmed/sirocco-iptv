import "pkg:/source/lib/Log.bs"

' Entry point. Creates the SceneGraph screen and hands control to MainScene.
sub Main(args as dynamic)
    ' Deep links arrive here as { contentId, mediaType, source: "external-control" }.
    Log.info("Main", "launch args " + FormatJson(args))
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.SetMessagePort(port)

    scene = screen.CreateScene("MainScene")
    screen.Show()

    ' Deep links that arrive while the channel is already running come through roInput, not args.
    input = CreateObject("roInput")
    input.SetMessagePort(port)

    ' Deep link: contentId = "<kind>:<id>", mediaType = movie | episode | live | season | series.
    ' Set after Show() so MainScene.init() has already built the screen stack to push onto.
    if args <> invalid then scene.launchArgs = args

    while true
        msg = wait(0, port)
        if type(msg) = "roSGScreenEvent"
            if msg.isScreenClosed() then return
        else if type(msg) = "roInputEvent"
            if msg.IsInput()
                Log.info("Main", "input event " + FormatJson(msg.GetInfo()))
                scene.launchArgs = msg.GetInfo()
            end if
        end if
    end while
end sub
